# Copy to .env and fill in. Every variable the code reads is listed here.

# Required — the app will not import without these
ANTHROPIC_API_KEY=sk-ant-...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567
TAVILY_API_KEY=tvly-...            # news search; read at import time

# Deployment
APP_URL=https://your-app.herokuapp.com   # where the app runs: Twilio status callbacks
# LINK_DOMAIN=palmr.at                   # optional short host for the links people READ.
#                                        # Must be a CNAME alias that SERVES the page, never
#                                        # a redirecting shortener — a redirect in front of
#                                        # the og tags breaks the link preview. Falls back
#                                        # to APP_URL. See docs/branded-messaging.md.
# DATABASE_URL=postgres://...            # set by Heroku; omit locally to use SQLite (palmer.db)
PALMER_CONTACT_EMAIL=you@example.com     # sent to the National Weather Service in the User-Agent, which NWS requires

# Features — each degrades gracefully when its key is absent
TOMTOM_API_KEY=...            # traffic, drive times, the commute
SERP_API_KEY=...              # product price watches, shopping, flights, hotels (SerpAPI)
GIPHY_API_KEY=...             # GIFs
TMDB_API_KEY=...              # movies and shows in the Opening section (free, non-commercial)
TICKETMASTER_API_KEY=...      # events in the Opening section

# Development flags
# PALMER_NO_SCHEDULER=1       # import main without starting the job loop (tests, shells, one-off scripts)
# DATA_ASK_DRY_RUN=1          # preview the missing-city asks without sending
